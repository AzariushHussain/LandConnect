POSTGRES_DB=landconnect
POSTGRES_USER=landconnect
POSTGRES_PASSWORD=local-development-password
POSTGRES_PORT=55432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://landconnect:local-development-password@127.0.0.1:55432/landconnect
DOCKER_DATABASE_URL=postgresql+psycopg://landconnect:local-development-password@db:5432/landconnect
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=["http://localhost:8081","http://localhost:3000"]
UPLOAD_DIR=uploads
REDIS_URL=redis://127.0.0.1:56379/0
REDIS_PORT=56379
CHAT_CHANNEL_PREFIX=landconnect:chat:local
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-development-livekit-secret-32-characters
LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Local development only. See docs/09-livekit-setup.md before testing a physical phone.
LIVEKIT_BIND_IP=127.0.0.1
# Advertised WebRTC media address; must be reachable from clients.
LIVEKIT_NODE_IP=127.0.0.1
CALL_RING_SECONDS=45
CALL_TOKEN_SECONDS=120
